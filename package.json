{
  "name": "ridge-road",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ridge Road: a tap-driven expedition sim of the 1813 crossing of the Blue Mountains",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "vite build && vite preview",
    "build:artifact": "vite build && node scripts/build-artifact.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "tsx sim/cli.ts",
    "check": "npm run typecheck && npm test",
    "replay": "tsx sim/replay.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
